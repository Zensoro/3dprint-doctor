<div id="tab_plugin_print_doctor" data-bind="visible: isVisible">
    <h1>Print Doctor</h1>
    <p>Defect alerts appear here during prints.</p>
    <table class="table table-striped table-hover">
        <thead><tr><th>Time</th><th>Message</th></tr></thead>
        <tbody data-bind="foreach: messages">
            <tr><td data-bind="text: time"></td>
                <td data-bind="text: text"></td></tr>
        </tbody>
    </table>
    <p class="text-muted" data-bind="visible: messages().length === 0">
        No alerts yet.
    </p>
</div>
